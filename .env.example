# 필수: 라이너 API 키 (platform.liner.com 에서 발급)
LINER_API_KEY=

# 선택: 식품안전나라 Open API 인증키 (foodsafetykorea.go.kr > 데이터활용서비스 > 이용신청)
# 비워 두면 공개 샘플 키로 호출합니다. 샘플은 일부 데이터만 돌려줘서 제품 등록 확인이 "확인 불가"로 나올 수 있습니다.
FOODSAFETY_API_KEY=

# 선택
PORT=8000
# 판정용 결정 모델. GET /v1/models 에서 endpoints에 /v1/decisions가 있는 모델
DECISION_MODEL=perplexity/pplx-decider-v1.2

# 선택: docker compose로 띄울 때 서버 바깥 포트 (기본 8000)
HOST_PORT=8000
